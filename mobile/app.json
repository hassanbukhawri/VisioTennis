{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "scheme": "visiotennis",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VisioTennis to access your photos to pick a stroke video.",
          "cameraPermission": "Allow VisioTennis to use the camera to record a stroke video.",
          "microphonePermission": "Allow VisioTennis to use the microphone while recording video."
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
